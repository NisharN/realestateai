# Scraper-specific environment template
# Copy the values you need into backend/.env

# Use a real browser channel when challenge-protected sites behave differently
# than Playwright's bundled Chromium. Common value on Windows: chrome
SCRAPER_BROWSER_CHANNEL=chrome

# Run visible browser while capturing or debugging a challenge-protected session
SCRAPER_HEADLESS=false

# Reuse a real Chrome/Chromium user data directory instead of exported storage state.
# Example on Windows:
# SCRAPER_USER_DATA_DIR=C:/Users/your-user/AppData/Local/Google/Chrome/User Data
# SCRAPER_PROFILE_NAME=Default
SCRAPER_USER_DATA_DIR=
SCRAPER_PROFILE_NAME=Default

# Reusable storage state for one manually solved session.
# Use one file per portal when needed.
SCRAPER_STORAGE_STATE_PATH=./runtime/scraper-state/bayut.json

# Directory for saved state files
SCRAPER_STATE_DIR=./runtime/scraper-state

# Comma-separated residential proxies. Supported formats:
# http://host:port
# http://user:pass@host:port
# socks5://user:pass@host:port
PROXY_LIST=http://user:pass@res-proxy-1:8000,http://user:pass@res-proxy-2:8000

# Optional approved alternate feed when public browse pages are blocked
APPROVED_FEED_URL=https://provider.example.com/listings.json
APPROVED_FEED_TOKEN=replace-me

# Optional RapidAPI-backed UAE real-estate source
RAPIDAPI_UAE_REAL_ESTATE_KEY=replace-me
RAPIDAPI_UAE_REAL_ESTATE_HOST=uae-real-estate3.p.rapidapi.com
