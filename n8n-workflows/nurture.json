{
  "name": "Dubai Real Estate - Lead Nurture Sequence",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "lead-nurture"
    },
    {
      "parameters": {
        "operation": "select",
        "table": "leads",
        "options": {}
      },
      "id": "get-lead",
      "name": "Get Lead from DB",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-1",
              "leftValue": "={{ $json.status }}",
              "rightValue": "nurture",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "check-status",
      "name": "Is Nurture?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "jsCode": "// Calculate delay based on lead created_at and build nurture message\n
const lead = items[0].json;
const createdAt = new Date(lead.created_at);
const now = new Date();
const daysSince = Math.floor((now - createdAt) / (1000 * 60 * 60 * 24));

let message = '';
let subject = '';

if (daysSince === 1) {
  message = `Hi ${lead.first_name || 'there'}, welcome to Dubai Real Estate AI! Here's what's new in ${lead.area_preference?.[0] || 'Dubai'} this week.`;
  subject = 'Welcome to Dubai Real Estate AI';
} else if (daysSince === 3) {
  message = `Hi ${lead.first_name || 'there'}, I noticed you were interested in ${lead.property_type || 'properties'}. Here are 3 new listings that match your criteria.`;
  subject = 'New Properties Matching Your Search';
} else if (daysSince === 7) {
  message = `Hi ${lead.first_name || 'there'}, would you like to schedule a site visit? Our specialist can show you around ${lead.area_preference?.[0] || 'Dubai'} this weekend.`;
  subject = 'Schedule Your Site Visit';
} else if (daysSince === 14) {
  message = `Hi ${lead.first_name || 'there'}, prices in ${lead.area_preference?.[0] || 'Dubai'} have shifted. Here's an updated market report.`;
  subject = 'Dubai Market Update';
} else if (daysSince === 30) {
  message = `Hi ${lead.first_name || 'there'}, it's been a month! Are you still looking? I'd love to help you find the perfect property.`;
  subject = 'Still Searching?';
}

return [{
  json: {
    ...lead,
    message,
    subject,
    days_since: daysSince
  }
}];"
      },
      "id": "build-message",
      "name": "Build Nurture Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [850, 200]
    },
    {
      "parameters": {
        "sendOptions": {},
        "options": {},
        "fromEmail": "ali@dubai-realestate-ai.com",
        "toEmail": "={{ $json.email }}",
        "subject": "={{ $json.subject }}",
        "text": "={{ $json.message }}"
      },
      "id": "send-email",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [1050, 200]
    },
    {
      "parameters": {
        "phoneNumberId": "={{ $env.WHATSAPP_PHONE_NUMBER_ID }}",
        "recipientPhoneNumber": "={{ $json.phone }}",
        "text": "={{ $json.message }}"
      },
      "id": "send-whatsapp",
      "name": "Send WhatsApp",
      "type": "n8n-nodes-base.whatsapp",
      "typeVersion": 1,
      "position": [1050, 400]
    },
    {
      "parameters": {
        "operation": "update",
        "table": "activities",
        "columns": {
          "lead_id": "={{ $json.id }}",
          "activity_type": "nurture_email",
          "description": "={{ $json.subject }}",
          "performed_by": "n8n_workflow"
        }
      },
      "id": "log-activity",
      "name": "Log Activity",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [1250, 300]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Get Lead from DB",
